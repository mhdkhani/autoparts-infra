# Rendered by the nginx image's envsubst into /etc/nginx/conf.d/default.conf.
# ${VAR} values come from .env; nginx's own $variables are left untouched.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream backend  { server ${BACKEND_HOST}:${PORT}; }
upstream frontend { server ${FRONTEND_HOST}:${PORT}; }

server {
    listen ${NGINX_PORT};
    server_name _;
    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

    proxy_http_version 1.1;
    # $http_host keeps the port (localhost:8088) so absolute redirects built by the apps are right
    proxy_set_header Host              $http_host;
    proxy_set_header X-Forwarded-Host  $http_host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade           $http_upgrade;     # websockets / Next HMR
    proxy_set_header Connection        $connection_upgrade;

    # /api prefix is kept; NestJS uses app.setGlobalPrefix('api')
    location /api/ {
        proxy_pass http://backend;
    }

    # uploaded files (logo, …) straight from the media volume; written only by the backend
    location ${MEDIA_URL}/ {
        alias ${MEDIA_DIR}/;
        add_header X-Content-Type-Options nosniff;
        expires 30d;
        try_files $uri =404;
    }

    location / {
        proxy_pass http://frontend;
    }
}
