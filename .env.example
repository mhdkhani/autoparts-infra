# =====================================================================
#  The ONLY place for settings. docker-compose*.yml contain no values:
#  every service loads this file (env_file) and compose reads image
#  names / ports from it. ${VAR} references inside this file are resolved.
#  Copy to .env and change the secrets.
# =====================================================================

# ---------- Compose ----------
COMPOSE_PROJECT_NAME=autoparts
# On a dev machine, uncomment so plain `docker compose ...` includes the dev override:
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# ---------- Images ----------
REGISTRY=autoparts
BACKEND_TAG=latest
FRONTEND_TAG=latest
IMAGE_NGINX=nginx:latest
IMAGE_POSTGRES=postgres:17
IMAGE_REDIS=redis:8-alpine
IMAGE_ELASTICSEARCH=elasticsearch:8.18.1
# kafka-native (GraalVM, ~50 MB) is meant for dev/test; for production use the
# JVM image apache/kafka:3.9.1 — same settings, just swap this line.
IMAGE_KAFKA=apache/kafka-native:3.9.1

# ---------- Host ports (published on the machine) ----------
HOST_HTTP_PORT=80
# dev only (docker-compose.dev.yml)
HOST_BACKEND_PORT=3011
HOST_FRONTEND_PORT=3010
HOST_DEBUG_PORT=9229
HOST_POSTGRES_PORT=5433
HOST_REDIS_PORT=6380
HOST_ES_PORT=9200
HOST_KAFKA_PORT=29092

# =====================================================================
#  NestJS (backend) + Next.js (frontend)
# =====================================================================
# development on dev machines, production on servers
NODE_ENV=development
# address both apps listen on inside their containers
BIND_HOST=0.0.0.0
# container port of both apps (Nest main.ts, next dev / standalone server.js)
PORT=3000
# Node inspector port inside the backend dev container
DEBUG_PORT=9229
BACKEND_HOST=backend
FRONTEND_HOST=frontend
# frontend: SSR → backend directly; browser → nginx (/api).
# Both are read at runtime (not baked into the build), so one image fits every env.
API_INTERNAL_URL=http://${BACKEND_HOST}:${PORT}
PUBLIC_API_URL=/api
NEXT_TELEMETRY_DISABLED=1
# next dev file watching through the bind mount (ignored in prod)
WATCHPACK_POLLING=true

# =====================================================================
#  Auth (backend users module) — admin and customer are fully separate
# =====================================================================
# frontend (Next.js) only — Secure flag of its httpOnly cookies (the API itself uses no cookies).
# true when the site is served over HTTPS (production); false for plain http dev
COOKIE_SECURE=false
# HS256 secrets, at least 32 chars, different from each other. Generate: openssl rand -hex 32
ADMIN_JWT_SECRET=change-me-to-64-hex-chars-openssl-rand-hex-32-admin-secret
CUSTOMER_JWT_SECRET=change-me-to-64-hex-chars-openssl-rand-hex-32-customer-secret
# token / cookie lifetime: admin 8 hours, customer 30 days
ADMIN_JWT_TTL_SECONDS=28800
CUSTOMER_JWT_TTL_SECONDS=2592000
# login / register rate limit: AUTH_THROTTLE_LIMIT attempts per AUTH_THROTTLE_TTL_MS, per IP and route
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=5
# admin account lock ("کاربران قفل‌شده"): after ADMIN_LOCK_MAX_FAILURES wrong passwords in a row
# the admin can't log in for ADMIN_LOCK_MINUTES (or until unlocked in the panel)
ADMIN_LOCK_MAX_FAILURES=5
ADMIN_LOCK_MINUTES=30

# dev seed only (`npx tsx src/db/seed.ts`, refused when NODE_ENV=production):
# password of every sample admin it creates. At least 10 chars.
SEED_ADMIN_PASSWORD=change-me-seed-password

# =====================================================================
#  Uploaded files (logo, …): a Docker volume mounted at MEDIA_DIR in backend (rw) and
#  nginx (ro); nginx serves it under MEDIA_URL. media-init chowns it to MEDIA_UID
#  (the node user of the prod backend image).
# =====================================================================
MEDIA_DIR=/srv/media
MEDIA_URL=/media
MEDIA_UID=1000

# =====================================================================
#  nginx (values substituted into nginx/templates/*.template)
# =====================================================================
NGINX_PORT=80
NGINX_CLIENT_MAX_BODY_SIZE=20m

# =====================================================================
#  PostgreSQL
# =====================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# the postgres server listens on PGPORT
PGPORT=${POSTGRES_PORT}
POSTGRES_DB=autoparts
POSTGRES_USER=autoparts
POSTGRES_PASSWORD=change-me

# =====================================================================
#  Redis
# =====================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# =====================================================================
#  Elasticsearch (ES_SETTING_FOO_BAR → foo.bar in elasticsearch.yml)
# =====================================================================
ELASTICSEARCH_HOST=elasticsearch
ES_SETTING_HTTP_PORT=9200
ES_SETTING_DISCOVERY_TYPE=single-node
# false is OK only while ES is not reachable from outside the Docker network
ES_SETTING_XPACK_SECURITY_ENABLED=false
ES_JAVA_OPTS=-Xms1g -Xmx1g
ELASTICSEARCH_URL=http://${ELASTICSEARCH_HOST}:${ES_SETTING_HTTP_PORT}

# =====================================================================
#  Kafka (apache/kafka: KAFKA_FOO_BAR → foo.bar in server.properties)
#  Non-broker variables must NOT start with KAFKA_ (hence BROKER_*).
# =====================================================================
BROKER_HOST=kafka
BROKER_PORT=9092
BROKER_CONTROLLER_PORT=9093
# uid of the user the Kafka image runs as (kafka-init chowns the data volume)
BROKER_UID=1000
BROKER_DATA_DIR=/var/lib/kafka/data
# what the backend connects to
BROKERS=${BROKER_HOST}:${BROKER_PORT}

CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_CONTROLLER_QUORUM_VOTERS=${KAFKA_NODE_ID}@${BROKER_HOST}:${BROKER_CONTROLLER_PORT}
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:${BROKER_PORT},CONTROLLER://0.0.0.0:${BROKER_CONTROLLER_PORT},EXTERNAL://0.0.0.0:${HOST_KAFKA_PORT}
# containers use kafka:9092, apps running on the host use localhost:29092
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://${BROKER_HOST}:${BROKER_PORT},EXTERNAL://localhost:${HOST_KAFKA_PORT}
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT,EXTERNAL:PLAINTEXT
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_LOG_DIRS=${BROKER_DATA_DIR}
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
